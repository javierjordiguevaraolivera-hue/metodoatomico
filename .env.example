# Copia este archivo como .env.local (en tu compu) y pon los mismos valores en Vercel → Settings → Environment Variables.

# Dominio público, sin "/" al final
NEXT_PUBLIC_SITE_URL=https://www.metodoatomico.lat

# Interruptor: "true" manda todo el tráfico al link de afiliado de Hotmart (como al principio), con los parámetros de la URL.
# Sin la variable (o con otro valor) queda la landing con el checkout de dLocal Go. Después de cambiarla, redeploy en Vercel.
# /acceso, /mis-accesos, /gracias y la API (webhook de dLocal) siguen funcionando aunque esté en "true".
# HOTMART_REDIRECT=true

# ===== dLocal Go =====
# "sandbox" para pruebas, "production" para cobrar de verdad (cada modo tiene sus propias llaves)
NEXT_PUBLIC_DLOCALGO_ENV=sandbox
# Dashboard de dLocal Go → Integraciones / API: API Key y Secret Key (la secret nunca va en el navegador)
DLOCALGO_API_KEY=
DLOCALGO_SECRET_KEY=
# Llave de SmartFields (tarjeta dentro de la página). Se pide al soporte de dLocal Go por el chat del dashboard.
# Si la dejas vacía, el botón lleva al checkout de dLocal Go con todos los métodos.
NEXT_PUBLIC_DLOCALGO_SMARTFIELDS_KEY=


# ===== Meta (Facebook) =====
NEXT_PUBLIC_META_PIXEL_ID=28161017416906832
# Token de la API de Conversiones: Administrador de eventos → tu píxel → Configuración → Generar token de acceso
META_CAPI_TOKEN=
# Solo para probar en "Probar eventos" del Administrador de eventos; bórralo en producción
META_TEST_EVENT_CODE=

# ===== TikTok (píxel + Events API) =====
NEXT_PUBLIC_TIKTOK_PIXEL_ID=DBKUCKRC77U4VUSMEKA0
# Token de la Events API: TikTok Ads Manager → Herramientas → Eventos → tu píxel → Configuración → Generar token de acceso
TIKTOK_ACCESS_TOKEN=
# Solo para probar en "Probar eventos" de TikTok; bórralo en producción
TIKTOK_TEST_EVENT_CODE=

# ===== Supabase (registro de compradores y archivos descargables) =====
# Dashboard de Supabase → Project Settings → API
SUPABASE_URL=
# "service_role" (secret): solo servidor. Nunca con NEXT_PUBLIC_ ni en el código.
SUPABASE_SERVICE_ROLE_KEY=
# Solo para crear las tablas: Project Settings → Database → Connection string → URI. Se puede borrar después.
SUPABASE_DB_URL=

# ===== Acceso de compradores =====
# Firma la sesión de /acceso (dura 2 horas). Genera una al azar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACCESS_SESSION_SECRET=

# ===== Brevo (correo de bienvenida con el acceso) =====
# Brevo → SMTP & API → API Keys
BREVO_API_KEY=
# Remitente verificado en Brevo con tu dominio
BREVO_SENDER_EMAIL=acceso@metodoatomico.lat
BREVO_SENDER_NAME=Método Atómico

# Archivos de más de 50 MB (no entran en Supabase gratis): nombre exacto -> link de descarga.
# DESCARGAS_EXTERNAS={"ATOM ELITE - Ejemplo estrella verde.zip":"https://..."}
